{
  "name": "@dayme/scriptc-raylib",
  "version": "0.1.9",
  "description": "Typed raylib bindings for scriptc — 521 native FFI functions, no JS engine in the binary",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./ffi": "./gen/raylib_ffi.json",
    "./colors": {
      "types": "./src/colors.d.ts",
      "import": "./src/colors.ts",
      "default": "./src/colors.ts"
    },
    "./constants": {
      "types": "./src/constants.d.ts",
      "import": "./src/constants.ts",
      "default": "./src/constants.ts"
    },
    "./types": {
      "types": "./src/types.d.ts",
      "import": "./src/types.ts",
      "default": "./src/types.ts"
    }
  },
  "bin": {
    "scriptc-raylib": "./lib/cli.mjs"
  },
  "files": [
    "src",
    "lib",
    "gen/raylib_ffi.json",
    "gen/raylib_ffi.ts",
    "gen/raylib_ffi.d.ts",
    "gen/raylib.ts",
    "gen/raylib.d.ts",
    "gen/raylib_shim.c",
    "raylib.schema.json",
    "build.sh",
    "build.ps1",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun tools/build.ts",
    "build:types": "tsc src/index.ts --declaration --emitDeclarationOnly --outDir . --moduleResolution bundler --target ESNext --module ESNext --skipLibCheck",
    "build:sh": "./build.sh",
    "gen": "bun tools/gen_bindings.ts",
    "demo": "bun run build && ./demo/demo",
    "example": "bun tools/run_example.ts",
    "run": "bun tools/run_example.ts",
    "test": "bun run test:coverage && bun run test:package",
    "test:coverage": "bun tools/test_coverage.ts",
    "test:package": "bun tools/test_package.ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "node ./lib/cli.mjs postinstall",
    "prepublishOnly": "bun run typecheck && bun run build:types && bun run test"
  },
  "keywords": [
    "raylib",
    "scriptc",
    "ffi",
    "bindings",
    "game",
    "gamedev",
    "graphics",
    "native",
    "aot",
    "typescript"
  ],
  "author": "Lisovskii Ivan <daymedead.dev@gmail.com>",
  "license": "Zlib",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LisovskiyIvan/scriptc-raylib.git"
  },
  "bugs": {
    "url": "https://github.com/LisovskiyIvan/scriptc-raylib/issues"
  },
  "homepage": "https://github.com/LisovskiyIvan/scriptc-raylib#readme",
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "typescript": "^5.9.3"
  }
}