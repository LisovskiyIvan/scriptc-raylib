{
  "name": "craylib",
  "version": "0.1.0",
  "description": "Fast typed raylib bindings for scriptc (TypeScript to native AOT)",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./ffi": "./gen/raylib_ffi.json",
    "./colors": "./src/colors.ts",
    "./constants": "./src/constants.ts",
    "./types": "./src/types.ts"
  },
  "files": [
    "src",
    "gen",
    "assets",
    "build.sh",
    "build.ps1",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun tools/build.ts",
    "build:sh": "./build.sh",
    "gen": "bun tools/gen_bindings.ts",
    "demo": "bun run build && ./demo/demo",
    "example": "bun tools/run_example.ts",
    "run": "bun tools/run_example.ts"
  },
  "keywords": [
    "raylib",
    "scriptc",
    "game",
    "gamedev",
    "graphics",
    "native",
    "typescript",
    "bindings"
  ],
  "author": "Lisovskii Ivan <daymedead.dev@gmail.com>",
  "license": "Zlib",
  "peerDependencies": {
    "typescript": "^5"
  }
}
